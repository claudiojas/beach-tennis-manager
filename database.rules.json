{
    "rules": {
        ".read": true,
        "tournaments": {
            ".indexOn": "createdAt",
            ".write": "auth != null"
        },
        "matches": {
            ".indexOn": "tournamentId",
            ".write": true
        },
        "courts": {
            ".indexOn": [
                "tournamentId",
                "pin"
            ],
            ".write": true
        },
        "results": {
            ".indexOn": "tournamentId",
            ".write": true
        },
        "athletes": {
            ".write": "auth != null"
        },
        "arenas": {
            ".write": "auth != null"
        },
        "sponsors": {
            ".write": "auth != null"
        }
    }
}