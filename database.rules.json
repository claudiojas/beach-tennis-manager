{
  "rules": {
    ".read": true,
    "tournaments": {
      ".indexOn": ["createdAt", "status"],
      ".write": "auth != null"
    },
    "matches": {
      ".indexOn": ["tournamentId", "categoryId", "category", "round", "status"],
      ".write": true
    },
    "courts": {
      ".indexOn": ["tournamentId", "pin"],
      ".write": true
    },
    "results": {
      ".indexOn": ["tournamentId", "categoryId", "matchId"],
      ".write": true
    },
    "athletes": {
      ".write": "auth != null"
    },
    "arenas": {
      ".indexOn": "name",
      ".write": "auth != null"
    },
    "sponsors": {
      ".indexOn": "tournamentId",
      ".write": "auth != null"
    },
    "categories": {
      ".indexOn": "name",
      ".write": "auth != null"
    }
  }
}